      "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435",
      "\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u043D\u0438\u0435",
      "\u0429\u0438\u0442 \u0441\u0438\u043B\u043E\u0432\u043E\u0439 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439",
      "\u041A\u0430\u0431\u0435\u043B\u044C\u043D\u0430\u044F \u0442\u0440\u0430\u0441\u0441\u0430 \u0438\u0437 N \u043A\u0430\u0431\u0435\u043B\u0435\u0439 \u0432 \u043B\u043E\u0442\u043A\u0435",
      "\u041A\u0430\u0431\u0435\u043B\u044C\u043D\u0430\u044F \u0442\u0440\u0430\u0441\u0441\u0430 \u0438\u0437 N \u043A\u0430\u0431\u0435\u043B\u0435\u0439 \u043F\u043E \u043F\u043E\u0442\u043E\u043B\u043A\u0443",
      "\u041A\u0430\u0431\u0435\u043B\u044C\u043D\u0430\u044F \u0442\u0440\u0430\u0441\u0441\u0430 \u0438\u0437 N \u043A\u0430\u0431\u0435\u043B\u0435\u0439 \u043F\u043E \u043F\u043E\u043B\u0443",
      " \u0420\u043E\u0437\u0435\u0442\u043A\u0430 230\u0412 \u0432\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u043C\u0430\u044F, \u0441\u043A\u0440\u044B\u0442\u0430\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430",
