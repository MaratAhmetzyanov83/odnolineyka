(setvar "CMDECHO" 0) (setvar "FILEDIA" 0)
(setvar "CTAB" "Model")
(if (member "ГРЩ-ЖД" (mapcar 'cdr (vl-remove-if-not '(lambda (x) (= (car x) 3)) (dictsearch (namedobjdict) "ACAD_LAYOUT"))))
  (command "_.-LAYOUT" "_Delete" "ГРЩ-ЖД"))
(setq ss (ssget "_X" '((410 . "Model"))) i 0 n 0)
(while (< i (sslength ss))
  (setq e (ssname ss i) d (entget e) p (cdr (assoc 10 d)))
  (if (or (and (= (cdr (assoc 0 d)) "INSERT") (= (cdr (assoc 2 d)) "A$C5c1f3258") (> (car p) 100000.0)) (and p (>= (car p) 30990.0) (<= (car p) 34800.0) (>= (cadr p) 3000.0) (<= (cadr p) 7400.0)))
    (progn (entdel e) (setq n (1+ n))))
  (setq i (1+ i)))
(princ (strcat "\nCLEANED=" (itoa n) "\n"))
