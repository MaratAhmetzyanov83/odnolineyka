FORMULAS [["=Диапазоны!B4", "", "", "", "", "", "", "", "", "", "КРМ", "", "", "РАСЧЁТ Рр (СП 256)", "Весь щит (аварийн.)", "Секция 1"], ["P", "кВт", "", "Руст=", "=AF5", "кВт", "L1р=", "=O7*V9", "кВт", "", "=IF(((TAN(ACOS(V8))-0.35)*V6)<50,\"Не требуется \nСП256 П.7.3.2\",(TAN(ACOS(V8))-0.35)*V6)", "кВАр", "", "Руст (без «Нет»), кВт", "=IF(ISERROR($R$4),\"\",SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Быт\")+SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Сил\")+SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Пост\")+SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Щит\"))", "=IF(ISERROR($R$4),\"\",SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Быт\",$AJ$3:$AJ$1000,1)+SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Сил\",$AJ$3:$AJ$1000,1)+SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Пост\",$AJ$3:$AJ$1000,1)+SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Щит\",$AJ$3:$AJ$1000,1))"], ["", "", "", "Рр=", "=AF10", "кВт", "L2р=", "=P7*V9", "кВт", "", "", "", "", "Руст быт, кВт", "=IF(ISERROR($R$4),\"\",SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Быт\")+SUMIFS($AN$3:$AN$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Щит\"))", "=IF(ISERROR($R$4),\"\",SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Быт\",$AJ$3:$AJ$1000,1)+SUMIFS($AN$3:$AN$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Щит\",$AJ$3:$AJ$1000,1))"], ["P(L)", "кВт", "", "Iр=", "=AF12", "А", "L3р=", "=Q7*V9", "кВт", "", "", "", "", "Кс быт (табл. СП 256)", "=IF(ISERROR($R$4),\"\",IF(AF6>=INDEX(Кс_Р,ROWS(Кс_Р)),INDEX(Кс_К,ROWS(Кс_К)),INDEX(Кс_К,MATCH(AF6,Кс_Р,1))+(AF6-INDEX(Кс_Р,MATCH(AF6,Кс_Р,1)))*(INDEX(Кс_К,MATCH(AF6,Кс_Р,1)+1)-INDEX(Кс_К,MATCH(AF6,Кс_Р,1)))/(INDEX(Кс_Р,MATCH(AF6,Кс_Р,1)+1)-INDEX(Кс_Р,MATCH(AF6,Кс_Р,1)))))", "=IF(ISERROR($R$4),\"\",IF(AG6>=INDEX(Кс_Р,ROWS(Кс_Р)),INDEX(Кс_К,ROWS(Кс_К)),INDEX(Кс_К,MATCH(AG6,Кс_Р,1))+(AG6-INDEX(Кс_Р,MATCH(AG6,Кс_Р,1)))*(INDEX(Кс_К,MATCH(AG6,Кс_Р,1)+1)-INDEX(Кс_К,MATCH(AG6,Кс_Р,1)))/(INDEX(Кс_Р,MATCH(AG6,Кс_Р,1)+1)-INDEX(Кс_Р,MATCH(AG6,Кс_Р,1)))))"], ["P(L)", "%", "", "Cos(ф)=", "=IFERROR(SUMIF($C$3:$C$1000,$R$4,$L$3:$L$1000)/SUMIF($C$3:$C$1000,$R$4,$H$3:$H$1000),0.95)", "", "", "", "", "", "", "", "", "Рр сил = Σ P·Кс, кВт", "=IF(ISERROR($R$4),\"\",SUMIFS($AK$3:$AK$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Сил\")+SUMIFS($AP$3:$AP$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Щит\"))", "=IF(ISERROR($R$4),\"\",SUMIFS($AK$3:$AK$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Сил\",$AJ$3:$AJ$1000,1)+SUMIFS($AP$3:$AP$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Щит\",$AJ$3:$AJ$1000,1))"], ["ΔP(L)", "%", "", "Кс=", "=AF11", "", "", "", "", "", "", "", "", "Рр пост (Кс = 1), кВт", "=IF(ISERROR($R$4),\"\",SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Пост\")+SUMIFS($AQ$3:$AQ$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Щит\"))", "=IF(ISERROR($R$4),\"\",SUMIFS($H$3:$H$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Пост\",$AJ$3:$AJ$1000,1)+SUMIFS($AQ$3:$AQ$1000,$C$3:$C$1000,$R$4,$A$3:$A$1000,\"Щит\",$AJ$3:$AJ$1000,1))"], ["Iпуск (1ф)", "А", "", "", "", "", "", "", "", "", "", "", "", "Рр = быт·Кс + Ко·сил + пост, кВт", "=IF(ISERROR($R$4),\"\",AF6*AF7+Ко_сил*AF8+AF9)", "=IF(ISERROR($R$4),\"\",AG6*AG7+Ко_сил*AG8+AG9)"]]
