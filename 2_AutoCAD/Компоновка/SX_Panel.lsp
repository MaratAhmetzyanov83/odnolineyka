  (if cp:case
    (progn
      (setq sw (nth 5 cp:case) sh (nth 6 cp:case) cx (/ cp:railw 2.0) cy (/ (+ (cp:yc 0) (cp:yc (1- cp:totalrows))) 2.0))
      (cond ((= side 'left) (- cx (/ sw 2.0))) ((= side 'right) (+ cx (/ sw 2.0)))
            ((= side 'top) (+ cy (/ sh 2.0))) (t (- cy (/ sh 2.0)))))
    (cond ((= side 'left) 0.0) ((= side 'right) (cp:g 'w)) ((= side 'top) (cp:g 'h)) (t 0.0))))
(defun cp:draw-rails ( / r duct gap y1 y2 ytop ybot)
  (setq r 0)
  (repeat cp:totalrows
    (cp:rect -5.0 (- (cp:yc r) 17.5) (+ cp:railw 5.0) (+ (cp:yc r) 17.5) "CP_RAIL")
    (setq r (1+ r)))
  (if cp:case
    (progn
      (cp:rect (cp:case-box 'left) (cp:case-box 'bottom) (cp:case-box 'right) (cp:case-box 'top) "CP_CASE")
      (setq duct (nth 12 cp:case))
      (if (and duct (> duct 0) (/= (nth 3 cp:case) "MOD"))
        (progn
          (setq ytop (+ (cp:yc 0) (/ cp:maxh 2.0)) ybot (- (cp:yc (1- cp:totalrows)) (/ cp:maxh 2.0)))
          (cp:rect (- -10.0 duct) ybot -10.0 ytop "CP_DUCT")
          (cp:rect (+ cp:railw 10.0) ybot (+ cp:railw 10.0 duct) ytop "CP_DUCT")
          (setq gap (- cp:rowpitch cp:maxh) r 0)
          (if (>= gap (+ duct 10.0))
            (repeat (1- cp:totalrows)
              (setq y1 (/ (+ (cp:yc r) (cp:yc (1+ r))) 2.0))
              (cp:rect -10.0 (- y1 (/ duct 2.0)) (+ cp:railw 10.0) (+ y1 (/ duct 2.0)) "CP_DUCT")
              (setq r (1+ r)))))))))
(defun cp:draw-combs ( / p ytop ybot)
  (foreach s cp:segs
    (if (setq p (assoc (car (nth 4 s)) cp:posmapl))
      (progn
        (setq ytop (+ (nth 2 p) (/ (nth 4 p) 2.0)) ybot (- (nth 2 p) (/ (nth 4 p) 2.0)))
        (cp:rect (+ (nth 2 s) 1.0) (- ytop 7.0) (- (nth 3 s) 1.0) (- ytop 2.0) "CP_COMB")
        (cp:text (/ (+ (nth 2 s) (nth 3 s)) 2.0) (- ybot 6.0) 2.5
                 (strcat "PIN " (cp:class-name (car s)) ", " (itoa (fix (+ (nth 5 s) 0.5))) (cp:ru '(32 1084 1086 1076 46)))
                 (- (nth 3 s) (nth 2 s)) "CP_COMB")))))
(defun cp:railpitch-default (cfg / value height gap)
  (setq value (cdr (assoc 'railpitch cfg)) height (cdr (assoc 'devh cfg)) gap (cdr (assoc 'gap cfg)))
  (if (and (numberp value) (> value 0)) value
    (+ (if (numberp height) height 90.0) (if (numberp gap) gap 60.0))))
(defun cp:label-height (key fallback / value)
  (setq value (cp:g key))
  (if (and (numberp value) (> value 0)) value fallback))
(defun cp:defaults ( / cfg last)
  (setq cfg '((nrows . 0) (slots . 24) (pitch . 18.0) (reserve . 20.0)
              (gap . 60.0) (devh . 90.0)))
  (if (setq last (vlax-ldata-get "SX_PANEL" "last")) (setq cfg last))
  (if (null (assoc 'railpitch cfg)) (setq cfg (cons (cons 'railpitch (cp:railpitch-default cfg)) cfg)))
  (if (null (assoc 'textheight cfg)) (setq cfg (cons '(textheight . 4.0) cfg)))
  (if (null (assoc 'xttextheight cfg)) (setq cfg (cons '(xttextheight . 2.0) cfg)))
  (if (null (assoc 'oneblock cfg)) (setq cfg (cons '(oneblock . T) cfg)))
  (if (null (assoc 'gap cfg)) (setq cfg (cons '(gap . 60.0) cfg)))
  ;; v2.0: новые компоновки — фазы, гребёнки, N/PE, провода, корпус, запись в Excel.
  (foreach p '((comb . T) (dense . T) (npe . T) (wiring . T) (excel . T) (rails . T) (case . "") (caseseries . "ST"))
    (if (null (assoc (car p) cfg)) (setq cfg (cons p cfg))))
  (if (null (assoc 'library cfg)) (setq cfg (cons (cons 'library (cp:default-library)) cfg)))
  (if (null (assoc 'path cfg)) (setq cfg (cons (cons 'path (getenv "SX_LastXls")) cfg)))
  (if (null (assoc 'panel cfg)) (setq cfg (cons (cons 'panel (getenv "SX_LastPanel")) cfg)))
  cfg)

(defun cp:cfg-save ( / key val good)
  (setq good T)
  (foreach key '(nrows slots pitch reserve railpitch devh textheight xttextheight)
    (setq val (cp:num (get_tile (strcase (vl-symbol-name key) T))))
    (if (or (null val)
            (cond ((= key 'reserve) (or (< val 0) (>= val 100))) ((= key 'nrows) (< val 0)) (t (<= val 0)))
            (and (member key '(nrows slots)) (not (equal val (fix val) 0.000001))))
      (setq good nil)
      (cp:put key (if (member key '(nrows slots)) (fix val) val))))
  (if good
    (progn
      (cp:put 'oneblock (= (get_tile "oneblock") "1"))
      ;; Флажки и поля v2.0: в старых окнах их нет — значение не меняется.
      (foreach key '(comb dense npe excel)
        (if (setq val (get_tile (strcase (vl-symbol-name key) T))) (progn (cp:put key (= val "1")) (if (= key 'comb) (cp:put 'wiring (= val "1"))))))
      (if (setq val (get_tile "rails")) (cp:put 'rails (= val "1")))
      (foreach key '(case caseseries)
        (if (setq val (get_tile (strcase (vl-symbol-name key) T))) (cp:put key (vl-string-trim " " val))))
      (cp:put 'library (get_tile "library")) (cp:put 'panel (nth (atoi (get_tile "panel")) cp:panels)) (done_dialog 1))
    (set_tile "status" (cp:ru '(1055 1088 1086 1074 1077 1088 1100 1090 1077 32 1088 1072 1079 1084 1077 1088 1099 32 1080 32 1094 1077 1083 1086 1077 32 1082 1086 1083 1080 1095 1077 1089 1090 1074 1086 32 1088 1077 1077 1082 47 1084 1086 1076 1091 1083 1077 1081 46 32 1056 1077 1079 1077 1088 1074 58 32 48 8211 57 57 32 37 46 32 1056 1103 1076 1086 1074 58 32 48 32 8212 32 1072 1074 1090 1086 46)))))
(defun cp:dialog ( / id res key path)
  (cp:put 'railpitch (cp:railpitch-default cp:cfg))
  (cp:put 'textheight (cp:label-height 'textheight 4.0))
  (cp:put 'xttextheight (cp:label-height 'xttextheight 2.0))
  (if (null (setq path (cp:dcl-file))) (exit))
  (if (or (null (cp:g 'library)) (= (cp:g 'library) "") (not (findfile (cp:g 'library))))
    (cp:put 'library (cp:default-library)))
  (setq id (load_dialog path) res 2)
  (if (< id 0) (cp:fail (strcat (cp:ru '(1053 1077 32 1091 1076 1072 1083 1086 1089 1100 32 1079 1072 1075 1088 1091 1079 1080 1090 1100 32 1092 1072 1081 1083 32 1086 1082 1085 1072 58 32)) path)))
  (while (= res 2)
    (if (not (new_dialog "cp_main" id)) (cp:fail (cp:ru '(1053 1077 32 1091 1076 1072 1083 1086 1089 1100 32 1086 1090 1082 1088 1099 1090 1100 32 1086 1082 1085 1086 32 1082 1086 1084 1087 1086 1085 1086 1074 1082 1080 46))))
    (set_tile "file" (cp:s (cp:g 'path)))
    (set_tile "library" (cp:s (cp:g 'library)))
    (start_list "panel") (mapcar 'add_list cp:panels) (end_list)
    (set_tile "panel" (itoa (if (member (cp:g 'panel) cp:panels) (vl-position (cp:g 'panel) cp:panels) 0)))
    (foreach key '(nrows slots pitch reserve railpitch devh textheight xttextheight)
      (set_tile (strcase (vl-symbol-name key) T) (cp:s (cp:g key))))
    (set_tile "oneblock" (if (if (assoc 'oneblock cp:cfg) (cp:g 'oneblock) T) "1" "0"))
    (foreach key '(comb dense npe excel rails)
      (set_tile (strcase (vl-symbol-name key) T) (if (cp:g key) "1" "0")))
    (foreach key '(case caseseries)
      (set_tile (strcase (vl-symbol-name key) T) (cp:s (cp:g key))))
    (action_tile "browse" "(done_dialog 2)")
    (action_tile "accept" "(cp:cfg-save)") (action_tile "cancel" "(done_dialog 0)")
    (setq res (start_dialog))
    (if (= res 2)
      (if (setq path (getfiled (cp:ru '(69 120 99 101 108 32 1089 32 1086 1076 1085 1086 1083 1080 1085 1077 1081 1082 1086 1081)) (cp:g 'path) "xlsx;xlsm;xls" 0))
        (progn (cp:put 'path path) (cp:read-book path)))))
  (unload_dialog id)
  (= res 1))
(defun cp:size-fill ( / item size name)
  (setq item (nth cp:size-i cp:size-items) size (cdr (assoc (car item) cp:size-data)) name (car size))
  (set_tile "model" (cadr item))
  (set_tile "block" (itoa (if (member name cp:blocknames) (vl-position name cp:blocknames) 0)))
  (set_tile "scale" (cp:s (if (cadr size) (cadr size) 1.0)))
  (set_tile "rotation" (cp:s (if (caddr size) (caddr size) 0.0)))
  (cp:state-list (if name name "") (nth 3 size)))
(defun cp:size-store ( / key name scale rot size state)
  (setq key (car (nth cp:size-i cp:size-items)) name (nth (atoi (get_tile "block")) cp:blocknames)
        scale (cp:num (get_tile "scale")) rot (cp:num (get_tile "rotation")))
  (if (and name (/= name "") scale (> scale 0) rot)
    (progn
      (setq state (nth (atoi (get_tile "state")) cp:state-options) size (cons key (list name scale rot state)))
      (setq cp:size-data (if (assoc key cp:size-data) (subst size (assoc key cp:size-data) cp:size-data) (cons size cp:size-data))) T)
    (progn (set_tile "status" (cp:ru '(1042 1099 1073 1077 1088 1080 1090 1077 32 1074 1072 1096 32 1073 1083 1086 1082 44 32 1087 1086 1083 1086 1078 1080 1090 1077 1083 1100 1085 1099 1081 32 1084 1072 1089 1096 1090 1072 1073 32 1080 32 1091 1075 1086 1083 32 1087 1086 1074 1086 1088 1086 1090 1072 46))) nil)))
(defun cp:size-select (new)
