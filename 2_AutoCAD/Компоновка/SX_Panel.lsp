(defun cp:sheet-values (sh addr / rg vals)
  (setq rg (vlax-get-property sh 'Range addr))
  (setq vals (vl-catch-all-apply '(lambda () (vlax-safearray->list (vlax-variant-value (vlax-get-property rg 'Value2)))) nil))
  (cp:rel rg)
  (if (vl-catch-all-error-p vals) nil (mapcar '(lambda (r) (mapcar 'cp:v r)) vals)))
(defun cp:read-asm ( / sh vals rule colors)
  (setq cp:asm nil)
  (if (setq sh (cp:sheet-soft (cp:asm-name)))
    (progn
      (setq vals (cp:sheet-values sh "B4:B12"))
      (foreach p (mapcar 'cons '("L1" "L2" "L3" "N" "PE") (mapcar 'car vals))
        (if (and (cdr p) (/= (cp:s (cdr p)) "")) (setq colors (append colors (list (cons (car p) (cp:s (cdr p))))))))
      (if colors (setq cp:asm (cons (cons 'colors colors) cp:asm)))
      (if (/= (cp:s (car (nth 5 vals))) "") (setq cp:asm (cons (cons 'brand (cp:s (car (nth 5 vals)))) cp:asm)))
      (if (numberp (car (nth 6 vals))) (setq cp:asm (cons (cons 'reserve (float (car (nth 6 vals)))) cp:asm)))
      (if (numberp (car (nth 7 vals))) (setq cp:asm (cons (cons 'pct (float (car (nth 7 vals)))) cp:asm)))
      (if (and (numberp (car (nth 8 vals))) (> (car (nth 8 vals)) 0)) (setq cp:asm (cons (cons 'round (float (car (nth 8 vals)))) cp:asm)))
      (foreach r (cp:sheet-values sh "D5:E30")
        (if (and (numberp (car r)) (numberp (cadr r))) (setq rule (append rule (list (cons (float (car r)) (float (cadr r))))))))
      (if rule (setq cp:asm (cons (cons 'rule (vl-sort rule '(lambda (a b) (< (car a) (car b))))) cp:asm)))
      (cp:rel sh)))
  cp:asm)
(defun cp:put-values (sh addr rows ncol / sa i j v rg)
  (if rows
    (progn
      (setq sa (vlax-make-safearray vlax-vbVariant (cons 1 (length rows)) (cons 1 ncol)) i 1)
      (foreach r rows
        (setq j 1)
        (repeat ncol
          (setq v (nth (1- j) r))
          (vlax-safearray-put-element sa i j (cond ((null v) "") ((numberp v) v) (t (cp:s v))))
          (setq j (1+ j)))
        (setq i (1+ i)))
      (setq rg (vlax-get-property sh 'Range addr))
      (vlax-put-property rg 'Value2 (vlax-make-variant sa))
      (cp:rel rg))))
