  )

;;; Родительский блок и сохранённые параметры. Обновление меняет только выбранную компоновку.
(defun cp:tag (ob /)
  (regapp cp:app)
  (vla-setxdata ob
    (vlax-safearray-fill (vlax-make-safearray vlax-vbInteger '(0 . 1)) '(1001 1000))
    (vlax-safearray-fill (vlax-make-safearray vlax-vbVariant '(0 . 1)) (list cp:app (cp:g 'panel))))
  (vlax-ldata-put ob "settings" cp:cfg))
(defun cp:build (point / blocks name ob oldspace)
  (cp:layers) (cp:style)
  (setq blocks (vla-get-blocks cp:doc) name (strcat "CP_LAYOUT_" (itoa (abs (getvar "MILLISECS")))))
  (while (tblsearch "BLOCK" name) (setq name (strcat name "_")))
  (setq cp:newdef (vla-add blocks (cp:p 0.0 0.0) name) cp:space cp:newdef)
  (cp:draw-geometry)
  (setq ob (vla-insertblock (vla-get-modelspace cp:doc) (vlax-3d-point point) name 1.0 1.0 1.0 0.0))
  (setq cp:pendingnew ob)
  (vla-put-layer ob "CP_DEVICES") (cp:tag ob) ob)
(defun cp:pick ( / ss ob cfg)
  (if (setq ss (entsel (cp:ru '(1042 1099 1073 1077 1088 1080 1090 1077 32 1073 1083 1086 1082 32 1082 1086 1084 1087 1086 1085 1086 1074 1082 1080 58 32))))
    (progn
      (setq ob (vlax-ename->vla-object (car ss)))
      (if (and (= (vla-get-objectname ob) "AcDbBlockReference")
               (assoc -3 (entget (car ss) (list cp:app)))
               (setq cfg (vlax-ldata-get ob "settings")))
        (list ob cfg)
        (progn (princ (cp:ru '(1069 1090 1086 32 1085 1077 32 1082 1086 1084 1087 1086 1085 1086 1074 1082 1072 44 32 1089 1086 1079 1076 1072 1085 1085 1072 1103 32 67 80 68 82 65 87 46))) nil)))))
(defun cp:run (update edit / *error* pick old new point undo path ready)
  (defun *error* (msg)
    (cp:close-book) (cp:lib-close)
    (if (and cp:pendingnew (null new)) (vl-catch-all-apply 'vla-delete (list cp:pendingnew)))
    (if (and cp:newdef (null new)) (vl-catch-all-apply 'vla-delete (list cp:newdef)))
    (if undo (vl-catch-all-apply 'vla-endundomark (list cp:doc)))
    (if (not (member msg '("Function cancelled" "quit / exit abort"))) (princ (strcat "\nCPDRAW: " msg)))
    (princ))
  (setq cp:doc (vla-get-activedocument (vlax-get-acad-object)) cp:newdef nil cp:measure-cache nil cp:pendingnew nil)
  (if update
    (progn
      (if (null (setq pick (cp:pick))) (exit))
      (setq old (car pick) cp:cfg (cadr pick)
            point (vlax-safearray->list (vlax-variant-value (vla-get-insertionpoint old)))))
    (setq cp:cfg (cp:defaults)))
  (setq path (cp:g 'path))
  (if (or (null path) (not (findfile path))) (setq path (getfiled (cp:ru '(69 120 99 101 108 32 1089 32 1086 1076 1085 1086 1083 1080 1085 1077 1081 1082 1086 1081)) "" "xlsx;xlsm;xls" 0)))
  (if (null path) (exit))
  (cp:put 'path path) (cp:read-book path)
  (if (null cp:panels) (cp:fail (cp:ru '(1042 32 1086 1076 1085 1086 1083 1080 1085 1077 1081 1082 1077 32 1085 1077 1090 32 1097 1080 1090 1086 1074 46))))
  (if (and update (not edit) (not (member (cp:g 'panel) cp:panels))) (cp:fail (cp:ru '(1057 1086 1093 1088 1072 1085 1105 1085 1085 1099 1081 32 1097 1080 1090 32 1085 1077 32 1085 1072 1081 1076 1077 1085 32 1074 32 69 120 99 101 108 46 32 1048 1089 1087 1086 1083 1100 1079 1091 1081 1090 1077 32 67 80 69 68 73 84 32 1076 1083 1103 32 1074 1099 1073 1086 1088 1072 32 1076 1088 1091 1075 1086 1075 1086 32 1097 1080 1090 1072 46))))
  (cp:import-library)
  (if (and edit (not (cp:dialog))) (exit))
  (setq ready nil)
  (while (not ready)
    (cp:import-library)
    (cp:collect (cp:g 'panel)) (cp:apply-sizes)
    (if (or edit (vl-some '(lambda (d) (null (nth 7 d))) cp:devices))
      (if (not (cp:sizes-dialog)) (exit)))
    (if (cp:plan) (setq ready T)
      (progn (alert cp:problem) (if (not (cp:dialog)) (exit)))))
  (if (not update)
    (progn
      (setq point (getpoint (cp:ru '(1059 1082 1072 1078 1080 1090 1077 32 1090 1086 1095 1082 1091 32 1074 1089 1090 1072 1074 1082 1080 32 1082 1086 1084 1087 1086 1085 1086 1074 1082 1080 32 1072 1087 1087 1072 1088 1072 1090 1086 1074 58 32))))
      (if (null point) (exit))
      (setq point (trans point 1 0))))
  (vla-startundomark cp:doc) (setq undo T)
  (setq new (cp:build point))
  (if old
    (progn
      (vla-put-xscalefactor new (vla-get-xscalefactor old))
      (vla-put-yscalefactor new (vla-get-yscalefactor old))
      (vla-put-zscalefactor new (vla-get-zscalefactor old))
      (vla-put-rotation new (vla-get-rotation old))
      (vla-delete old)))
  (vlax-ldata-put "SX_PANEL" "last" cp:cfg)
  (vla-endundomark cp:doc) (setq undo nil)
  (cp:lib-close) (vla-regen cp:doc 1)
  (princ (strcat (cp:ru '(10 1050 1086 1084 1087 1086 1085 1086 1074 1082 1072 32 1087 1086 1089 1090 1088 1086 1077 1085 1072 58 32)) (cp:g 'panel) (cp:ru '(44 32 1072 1087 1087 1072 1088 1072 1090 1086 1074 32)) (itoa (length cp:devices)) (cp:ru '(44 32 1082 1083 1077 1084 1084 32)) (itoa (length cp:terminals)) "."))
  (princ))
(defun c:CPDRAW () (cp:run nil T))
(defun c:CPUPDATE () (cp:run T nil))
(defun c:CPEDIT () (cp:run T T))
(defun c:CPDELETE ( / pick doc)
  (if (setq pick (cp:pick))
    (progn (setq doc (vla-get-activedocument (vlax-get-acad-object)))
      (vla-startundomark doc) (vla-delete (car pick)) (vla-endundomark doc))) (princ))
(princ "\nSX_Panel v1.1: CPDRAW / CPUPDATE / CPEDIT / CPDELETE")
(princ)
